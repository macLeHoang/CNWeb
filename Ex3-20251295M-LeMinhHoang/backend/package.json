{
  "name": "it4409-rbac-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the IT4409 RBAC assignment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "demo": "node scripts/demo.js",
    "seed": "node seed.js",
    "test": "node --test --test-concurrency=1",
    "check:frontend": "node scripts/check-frontend.js",
    "verify:local": "node scripts/verify-local.js",
    "verify:online": "node -r dotenv/config scripts/verify-local.js dotenv_config_path=.runtime/online.env",
    "verify:experiments": "node scripts/experiments.js",
    "verify:backend": "node scripts/record-tests.js",
    "verify:publishing": "node scripts/verify-publishing.js",
    "report": "node scripts/build-report.js",
    "package:submission": "node scripts/package-submission.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "docx": "^9.15.0",
    "jszip": "^3.10.2",
    "mongodb-memory-server": "^10.3.0",
    "newman": "^6.2.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4"
  }
}
